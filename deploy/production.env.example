# Copy to .env in the project root on the production server.
# Fill DB_PASSWORD, STORAGE_SIGNING_SECRET, INTERNAL_WORKER_SECRET and SMTP_PASSWORD.
NODE_ENV=production
FRONTEND_URL=https://duonglearning.io.vn
API_PUBLIC_URL=https://duonglearning.io.vn
VITE_API_URL=https://duonglearning.io.vn
API_PORT=8787
# Use 1 only when the API is behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edugame
DB_USER=edugame_app
DB_PASSWORD=
STORAGE_ROOT=data/storage
STORAGE_SIGNING_SECRET=
INTERNAL_WORKER_SECRET=

# Gmail SMTP; supply the app password via hosting environment or the private .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=nguyenngoctrunggtvt@gmail.com
SMTP_PASSWORD=
MAIL_FROM="Dương Learning <nguyenngoctrunggtvt@gmail.com>"
